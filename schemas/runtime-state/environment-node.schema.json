{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ep-osa-core/schemas/runtime-state/environment-node.schema.json",
  "title": "Environment Node",
  "type": "object",
  "required": ["id", "role", "specialization", "manifests"],
  "properties": {
    "id": { "type": "string" },
    "role": { "type": "string", "enum": ["orchestrator", "governor", "researcher", "executor", "hybrid"] },
    "specialization": { "type": "string" },
    "manifests": {
      "type": "object",
      "required": ["environment_manifest", "memory_map"],
      "properties": {
        "environment_manifest": { "type": "string" },
        "memory_map": { "type": "string" }
      },
      "additionalProperties": false
    },
    "priority": { "type": "integer", "minimum": 1, "maximum": 100 },
    "enabled": { "type": "boolean", "default": true }
  },
  "additionalProperties": false
}
